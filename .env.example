# El backend expone todo bajo el prefijo /api (ver setGlobalPrefix en main.ts).
# Se ignora al correr `pnpm dev:https` (ver vite.config.ts): ese modo fuerza la
# API a un path relativo para poder probar la cámara del escáner de puerta
# desde el celular por HTTPS.
VITE_API_URL=http://localhost:3000/api

# Registro de errores en producción (Sentry). Opcional: vacía, el monitoreo se
# apaga solo y el SDK ni se descarga. Para activarlo: crear el proyecto en
# sentry.io (tier gratis alcanza) y pegar acá el DSN que da al crearlo.
VITE_SENTRY_DSN=
